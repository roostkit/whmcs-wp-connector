<?xml version="1.0"?>
<ruleset name="WHMCS Connector">
    <description>WordPress Coding Standards for WHMCS Connector by RoostKit</description>

    <!-- Scan these files -->
    <file>whmcs-connector.php</file>
    <file>includes/</file>

    <!-- Exclude generated/vendor files -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>dist/</exclude-pattern>
    <exclude-pattern>assets/blocks/build/</exclude-pattern>
    <exclude-pattern>tests/</exclude-pattern>

    <!-- Only scan PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Use WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax (PHP 8.1+) -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Allow PSR-4 filenames (class-based naming) -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <!-- Exceptions do not render to output directly -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <!-- WordPress-Extra includes security and best practices -->
    <rule ref="WordPress-Extra"/>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="whmcs-connector"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum WordPress version -->
    <config name="minimum_wp_version" value="6.4"/>

    <!-- Minimum PHP version -->
    <config name="minimum_supported_php_version" value="8.1"/>

    <!-- Show progress and use colors -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Use short open tags check -->
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
</ruleset>
