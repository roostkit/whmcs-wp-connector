{
    "name": "roostkit/whmcs-connector",
    "description": "WHMCS Connector by RoostKit. Connect your WHMCS installation to WordPress via the official WHMCS API.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://roostkit.site",
    "authors": [
        {
            "name": "Saleh Shojaei",
            "homepage": "https://roostkit.site"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoostKit\\WhmcsConnector\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoostKit\\WhmcsConnector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "build": "bash build.sh"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
